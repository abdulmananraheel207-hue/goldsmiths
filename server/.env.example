# ---- Server ----
PORT=4000
NODE_ENV=development
# The address the web app runs on (used for CORS). Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goldledger
# Separate database used only by `npm test` (it is wiped and re-created by the tests)
DB_NAME_TEST=goldledger_test

# ---- Security ----
# Long random string used to sign login sessions. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string
# Long random string used to encrypt the tax authority credential stored in Settings. CHANGE THIS.
# If you change it later, re-enter the tax credential in Settings > Tax Integration.
SETTINGS_ENCRYPTION_KEY=change-me-to-another-long-random-string
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# Maximum login attempts per 15 minutes from one address
LOGIN_RATE_LIMIT=10
